{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix website install --include=dev",
  "buildCommand": "npm --prefix website run build",
  "outputDirectory": "website/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/pdf", "destination": "/api/pdf.js" },
    { "source": "/api/visitors", "destination": "/api/visitors.js" },
    { "source": "/filtered", "destination": "/filtered.html" },
    { "source": "/((?!api|courses|filtered).*)", "destination": "/index.html" }
  ]
}
