{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/pdf", "destination": "/api/pdf.js" },
    { "source": "/courses/(.*)", "destination": "/courses/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
