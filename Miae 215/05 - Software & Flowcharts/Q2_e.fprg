<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Diane"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2020-10-09 12:30:35 PM"/>
        <attribute name="created" value="RGlhbmU7TEFQVE9QLTVDVTg0TTg0OzIwMjAtMTAtMDk7MTI6MTY6MzAgUE07Mjc1OQ=="/>
        <attribute name="edited" value="RGlhbmU7TEFQVE9QLTVDVTg0TTg0OzIwMjAtMTAtMDk7MTI6MzA6MzUgUE07MzsyODcw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="A" type="Real" array="True" size="30"/>
            <declare name="n, i" type="Integer" array="False" size=""/>
            <input variable="n"/>
            <if expression="n&lt;1">
                <then>
                    <assign variable="n" expression="1"/>
                </then>
                <else/>
            </if>
            <if expression="n&gt;30">
                <then>
                    <assign variable="n" expression="30"/>
                </then>
                <else/>
            </if>
            <for variable="i" start="0" end="n-1" direction="inc" step="1">
                <assign variable="A[i]" expression="sin(0.5*i)"/>
                <output expression="A[i]" newline="True"/>
                <if expression="(A[i] &gt; 0.5) &amp;&amp; (A[i] &lt; 0.7)">
                    <then>
                        <output expression="&quot;in range&quot;" newline="True"/>
                    </then>
                    <else>
                        <output expression="&quot;out of range&quot;" newline="True"/>
                    </else>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
